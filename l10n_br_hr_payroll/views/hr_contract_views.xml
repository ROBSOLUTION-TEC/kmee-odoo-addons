<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Odoo 20: contract data lives on hr.version, edited from the employee
         form (Payroll page) and from contract templates -->
    <record id="view_contract_form_payroll_br" model="ir.ui.view">
        <field name="name">hr.employee.form.contract.payroll.br</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='payroll_information']/group[@name='payroll_group']"
                position="after"
            >
                <group name="l10n_br_payroll_contract">
                    <group string="Adicionais de Risco" name="risk_additionals">
                        <field name="l10n_br_periculosidade" />
                        <field name="l10n_br_insalubridade" />
                        <field
                            name="l10n_br_grau_insalubridade"
                            invisible="not l10n_br_insalubridade"
                            required="l10n_br_insalubridade"
                        />
                    </group>
                    <group string="Encargos Patronais" name="l10n_br_hr_encargos">
                        <field name="l10n_br_hr_simples_anexo" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_contract_template_form_payroll_br" model="ir.ui.view">
        <field name="name">hr.version.template.form.payroll.br</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary_info']" position="after">
                <group name="l10n_br_payroll_contract">
                    <group string="Adicionais de Risco" name="risk_additionals">
                        <field name="l10n_br_periculosidade" />
                        <field name="l10n_br_insalubridade" />
                        <field
                            name="l10n_br_grau_insalubridade"
                            invisible="not l10n_br_insalubridade"
                            required="l10n_br_insalubridade"
                        />
                    </group>
                    <group string="Encargos Patronais" name="l10n_br_hr_encargos">
                        <field name="l10n_br_hr_simples_anexo" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
