<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_leave_type_form_inherit_br" model="ir.ui.view">
        <field name="name">hr.work.entry.type.form.br</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Configuracao CLT" name="grp_clt">
                    <group>
                        <field name="l10n_br_category" />
                        <field name="l10n_br_days_limit" />
                    </group>
                    <group>
                        <field name="l10n_br_need_attachment" />
                        <field name="l10n_br_payroll_discount" />
                        <field name="l10n_br_discount_dsr" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
