<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_l10n_br_hr_sst" model="ir.module.category">
        <field name="name">Saúde e Segurança do Trabalho</field>
        <field
            name="description"
        >Gestão de riscos ocupacionais, EPI, exames e acidentes de trabalho.</field>
        <field name="sequence">20</field>
    </record>

    <record model="res.groups.privilege" id="privilege_module_category_l10n_br_hr_sst">
        <field name="name">Saúde e Segurança do Trabalho</field>
        <field name="category_id" ref="module_category_l10n_br_hr_sst" />
    </record>

    <record id="group_sst_user" model="res.groups">
        <field name="name">Usuário</field>
        <field name="privilege_id" ref="privilege_module_category_l10n_br_hr_sst" />
        <field
            name="comment"
        >Consulta o inventário de riscos, laudos e ambientes.</field>
    </record>

    <record id="group_sst_manager" model="res.groups">
        <field name="name">Gestor</field>
        <field name="privilege_id" ref="privilege_module_category_l10n_br_hr_sst" />
        <field name="implied_ids" eval="[(4, ref('group_sst_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field
            name="comment"
        >Mantém laudos, ambientes e fatores de risco, e responde pelos eventos de SST.</field>
    </record>




</odoo>
