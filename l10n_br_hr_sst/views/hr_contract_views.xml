<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_contract_view_form_sst" model="ir.ui.view">
        <!-- Odoo 20: dados do contrato (hr.version) ficam no formulário do
             empregado, que mostra a versão corrente -->
        <field name="name">hr.employee.form.sst</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='payroll_information']" position="after">
                <page string="SST" name="sst" groups="hr.group_hr_user">
                    <group>
                        <group string="Ambiente e Exposição">
                            <field name="l10n_br_sst_ambiente_id" />
                            <field name="l10n_br_sst_exposicao_especial" />
                        </group>
                    </group>
                    <group string="Descrição das Atividades">
                        <field name="l10n_br_sst_descricao_atividade" nolabel="1" />
                    </group>
                    <group string="Riscos Aplicáveis">
                        <field name="l10n_br_sst_risco_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="agente_nocivo_id" />
                                <field name="tp_aval" />
                                <field name="intensidade" />
                                <field name="un_med" />
                                <field name="insalubridade" />
                                <field name="grau_insalubridade" />
                                <field name="periculosidade" />
                                <field name="laudo_id" />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
